// ApparelFlow ERP - Prisma Schema
// Production Batch Verification & Sewing Queue Gate (Full-Stack RBAC)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum 
enum Role {
  cutting_supervisor
  cutting_verifier
  sewing_supervisor
}

enum OrderStatus {
  CUTTING_IN_PROGRESS // Added: Assessment 6. MANUFACTURING STATE MACHINE
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ItemStatus {
  GREEN
  YELLOW
  RED
}

enum Decision {
  APPROVED
  REJECTED
}

// 1. users වගුව
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role
  full_name     String
  created_at    DateTime @default(now())

  cutting_orders    CuttingOrder[]
  verification_logs VerificationLog[]

  @@map("users")
}

// 2. recipes 
model Recipe {
  id               String   @id @default(uuid())
  recipe_code      String   @unique
  name             String
  category         String
  std_fabric_yards Float
  wastage_cap      Float

  components       RecipeComponent[]
  orders           CuttingOrder[]

  @@map("recipes")
}

// 3. recipe_components 
model RecipeComponent {
  id                 String  @id @default(uuid())
  recipe_id          String
  component_name     String
  pieces_per_garment Int
  image_url          String?

  recipe             Recipe  @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  verification_items VerificationItem[]

  @@map("recipe_components")
}

// 4. cutting_orders 
model CuttingOrder {
  id                String      @id @default(uuid())
  order_no          String      @unique
  recipe_id         String
  target_qty        Int
  fabric_roll_id    String
  actual_fabric_yds Float
  status            OrderStatus @default(CUTTING_IN_PROGRESS)
  created_by        String
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  recipe            Recipe      @relation(fields: [recipe_id], references: [id])
  creator           User        @relation(fields: [created_by], references: [id])
  items             VerificationItem[]
  verification_logs VerificationLog[]

  @@map("cutting_orders")
}

// 5. verification_items 
model VerificationItem {
  id           String      @id @default(uuid())
  order_id     String
  component_id String
  expected_qty Int
  actual_qty   Int?
  status       ItemStatus?

  order        CuttingOrder    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  component    RecipeComponent @relation(fields: [component_id], references: [id])

  @@unique([order_id, component_id])
  @@map("verification_items")
}

// 6. verification_logs 
model VerificationLog {
  id             String   @id @default(uuid())
  order_id       String
  verifier_id    String
  decision       Decision
  rejection_note String?
  wastage_pct    Float?
  timestamp      DateTime @default(now())

  order          CuttingOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  verifier       User         @relation(fields: [verifier_id], references: [id])

  @@map("verification_logs")
}
